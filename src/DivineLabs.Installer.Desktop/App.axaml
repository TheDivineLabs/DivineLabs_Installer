<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DivineLabs.Installer.Desktop.App" RequestedThemeVariant="Light">
<Application.Styles><FluentTheme/>
<Style Selector="Window"><Setter Property="FontSize" Value="14"/></Style>
<Style Selector="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,10"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
<Setter Property="Template"><ControlTemplate><Border Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter></Style>
<Style Selector="Button:pointerover /template/ Border#Body"><Setter Property="Opacity" Value="0.8"/></Style>
<Style Selector="Button:pressed /template/ Border#Body"><Setter Property="Opacity" Value="0.65"/></Style>
<Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
<Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="Button.chrome"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style Selector="Button.chrome"><Setter Property="CornerRadius" Value="0"/></Style>
<Style Selector="Button.chrome:pointerover /template/ Border#Body"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="{DynamicResource Surface}"/></Style>
<Style Selector="Button.chrome:pressed /template/ Border#Body"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="{DynamicResource Line}"/></Style>
<Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource WhiteSurface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,10"/></Style>
<Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="13"/></Style>
<Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/></Style>
</Application.Styles></Application>