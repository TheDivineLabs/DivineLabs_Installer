<Project><PropertyGroup>
<TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
<LangVersion>latest</LangVersion><Version>0.2.2</Version><Authors>DivineLabs</Authors><Company>DivineLabs</Company>
<RepositoryUrl>https://github.com/TheDivineLabs/DivineLabs_Installer</RepositoryUrl>
<Deterministic>true</Deterministic><ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
<IsAotCompatible>true</IsAotCompatible><JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
<IsPackable>false</IsPackable><PublishDocumentationFiles>false</PublishDocumentationFiles><AvaloniaVersion>12.1.4</AvaloniaVersion>
<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
</PropertyGroup></Project>
