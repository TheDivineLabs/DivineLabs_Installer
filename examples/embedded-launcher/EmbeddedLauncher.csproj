<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><PublishAot>true</PublishAot><InstallerPackageVersion>0.2.2</InstallerPackageVersion></PropertyGroup>
  <PropertyGroup Condition="'$(UseInstallerPackages)' == 'true'"><NuGetLockFilePath>packages.feed.lock.json</NuGetLockFilePath></PropertyGroup>
  <ItemGroup><PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/><PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/></ItemGroup>
  <ItemGroup Condition="'$(UseInstallerPackages)' != 'true'">
    <ProjectReference Include="../../src/DivineLabs.Installer.Core/DivineLabs.Installer.Core.csproj"/>
    <ProjectReference Include="../../src/DivineLabs.Installer.Platforms/DivineLabs.Installer.Platforms.csproj"/>
    <ProjectReference Include="../../src/DivineLabs.Installer.Components/DivineLabs.Installer.Components.csproj"/>
  </ItemGroup>
  <ItemGroup Condition="'$(UseInstallerPackages)' == 'true'">
    <PackageReference Include="DivineLabs.Installer.Core" Version="$(InstallerPackageVersion)"/>
    <PackageReference Include="DivineLabs.Installer.Platforms" Version="$(InstallerPackageVersion)"/>
    <PackageReference Include="DivineLabs.Installer.Components" Version="$(InstallerPackageVersion)"/>
  </ItemGroup>
</Project>
