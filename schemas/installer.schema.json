{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheDivineLabs/DivineLabs_Installer/main/schemas/installer.schema.json",
  "title": "DivineLabs Installer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "version",
    "applications"
  ],
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "const": 1,
      "default": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]{2,127}$"
    },
    "name": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "installDirectoryName": {
      "type": "string"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "enum": [
        "en",
        "ru"
      ]
    },
    "dataDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(win|osx|linux)-(x64|arm64)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entryPoint"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "entryPoint": {
              "type": "string"
            },
            "executableFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "cover": {
          "type": [
            "string",
            "null"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
